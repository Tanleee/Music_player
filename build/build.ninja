  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D D:\Espressif\Workspace\Music_player\build\esp-idf\esp_https_server && C:\Espressif\tools\cmake\4.0.3\bin\cmake.exe -DCMAKE_INSTALL_LOCAL_ONLY=1 -P cmake_install.cmake"
