  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D D:\Espressif\Workspace\Music_player\build\esp-idf\esp_psram && C:\Espressif\tools\cmake\4.0.3\bin\cmake.exe -DCMAKE_INSTALL_DO_STRIP=1 -P cmake_install.cmake"
  DESC = Installing the project stripped...
  pool = console
  restat = 1

build esp-idf/esp_psram/install/strip: phony esp-idf/esp_psram/CMakeFiles/install/strip.util

