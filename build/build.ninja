# Utility command for app-flash

build CMakeFiles/app-flash.util: CUSTOM_COMMAND app
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D D:\Espressif\Workspace\Music_player && C:\Espressif\tools\cmake\4.0.3\bin\cmake.exe -D IDF_PATH=C:/esp/v6.0.2/esp-idf -D SERIAL_TOOL=C:/Espressif/tools/python/v6.0.2/venv/Scripts/python.exe;-m;esptool;--chip;esp32c3 -D SERIAL_TOOL_ARGS=--before=default-reset;--after=hard-reset;write-flash;@app-flash_args -D WORKING_DIRECTORY=D:/Espressif/Workspace/Music_player/build -P C:/esp/v6.0.2/esp-idf/components/esptool_py/run_serial_tool.cmake"
  DESC = Running utility command for app-flash
  pool = console
  restat = 1

build app-flash: phony CMakeFiles/app-flash.util


